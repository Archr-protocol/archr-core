# Keeper wallet. Needs a little ETH for gas and earns the on-chain bounties and
# skims back. Keep the real key out of version control.
KEEPER_PRIVATE_KEY=

RPC_URL=https://rpc.mainnet.chain.robinhood.com
INTERVAL_MS=60000
# RUN_ONCE=1           # single pass, then exit

# ── Native cell ───────────────────────────────────────────────────────────────
# These must match the deployment the token list is drawn from. Pointing them at
# a different deployment fails to decode the launch record on every token.
DISTRIBUTOR_ADDRESS=0x80dC93B74Dd35f46fE80F3ecb615e6B7FD05AE20
LOCKER_ADDRESS=0x50f44F34021726A7F947Cf9a308CB4df882A77aB
LAUNCHPAD_ADDRESS=0x266c5e7e1C3E8B2645dED3eCFEc2447d681E198d
GATE_ADDRESS=0x2521d9638F734119E940Ec7056c073275D202A00
POOL_MANAGER_ADDRESS=0x8366a39CC670B4001A1121B8F6A443A643e40951
# Canonical WETH. Required by the pricing path: it is what ETH/USD is read
# through, even though the pools themselves are native-quoted.
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# ── Stock cell (off unless BOTH addresses are set) ────────────────────────────
# The stock distributor pays bounty and skim in each token's quote currency — a
# stock token rather than ether. Floors are derived in ETH and converted into
# quote units through USD prices.
STOCK_DISTRIBUTOR=0x00B16CBE742BB7Ae1999d2b8e88D050eadE24040
STOCK_LOCKER=0x673852e3E9a855b0d54e7C3239737aA73845E1Fa
STOCK_LAUNCHPAD_ADDRESS=0x780571700a8ccbA2074Fc08b768ddA63E06125aD
STOCK_GATE_ADDRESS=0x7599de487076dc57F3a0c78919542702b0102A00
# STOCK_TOKENS=0x…,0x…     # static list; otherwise the indexer's stock-cell rows
# STOCK_BACKOFF_TICKS=5    # ticks to skip a token after a revert (paused quote)

# ── Token discovery ───────────────────────────────────────────────────────────
# Query an indexer…
INDEXER_URL=https://archr.fun/api/indexer
# …or give a static comma-separated list, which takes precedence.
# TOKENS=0x…,0x…

# ── Incentive rates ───────────────────────────────────────────────────────────
# Read from chain at startup; these are only a fallback if that read fails. A
# mismatch is logged and the chain value wins.
BOUNTY_BPS=100
SKIM_BPS=100
PROCESS_SKIM_BPS=100

# ── Worth-it floors ───────────────────────────────────────────────────────────
# Every job fires only when the income it earns clears MARGIN x its gas cost,
# measured against the payout the contract itself reports from a simulation.
# There is deliberately no floor override: forcing a job below its floor means
# paying more gas than the job earns, on every tick, for every token.
# MARGIN=3
# COLLECT_GAS=420000            # crank()
# PROCESS_GAS=250000            # process(), the buyback path
# PUSH_GAS=60000                # claimForMany(), marginal cost per holder
# STOCK_COLLECT_GAS=400000      # crank() on the stock cell
# MIN_BUYBACK_ALLOWANCE_BPS=1   # skip `process` below this accrued allowance
# PUSH_BATCH=100                # holders per claimForMany call
# PUSH_ENABLED=true
# PROCESS_ENABLED=true

# ── Simulation ────────────────────────────────────────────────────────────────
# Simulate every job and send nothing. With RUN_ONCE=1 this walks every decision
# path against a fork without a funded key.
# DRY_RUN=true
# FORCE_PUSH=true      # exercise the push path during a dry run

# ── Runtime bounds ────────────────────────────────────────────────────────────
# Every value here is checked at startup; the keeper refuses to boot on a bad
# one rather than hot-looping or dying with an opaque trace.
# FETCH_TIMEOUT_MS=10000       # per-request cap on indexer and price calls
# PRICE_TTL_MS=60000           # price cache TTL
# PRICE_MAX_STALE_MS=3600000   # refuse a fallback price older than this
# HOLDER_SCAN_CHUNK=10000      # blocks per holder-derivation scan
# HOLDER_SCAN_FROM=0           # first block to scan from
# HEARTBEAT_FILE=/tmp/keeper-heartbeat   # touched by each completed tick
# DEXSCREENER_CHAIN_ID=robinhood

# ── Token to ETH sweep of accrued skims (default off) ─────────────────────────
# Native cell only: it builds native-ETH pool keys, so stock-cell skims stay as
# token inventory in the keeper wallet. Everything the sweep touches stays in
# that wallet — SWAP_PCT of each balance becomes ETH and the rest is held.
# SWEEP_ENABLED=true
# SWEEP_DRY_RUN=false          # default true (quote and log only)
# SWAP_PCT=100                 # % of each skim to swap to ETH
# SWEEP_GAS=180000
# MAX_SLIPPAGE_BPS=100
